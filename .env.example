POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=fitness_app

# Format: postgres://user:password@host:port/db?sslmode=disable
DATABASE_URL=postgres://postgres:your_db_password_here@db:5432/fitness_app?sslmode=disable

REDIS_URL=redis:6379

RABBITMQ_URL=amqp://appuser:your_rabbitmq_password_here@rabbitmq:5672/

PORT=8080

JWT_SECRET=your_jwt_secret_here

STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

BASE_URL=your_base_url_here

RABBITMQ_DEFAULT_USER=appuser
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here
