{
  "vhosts": [
        { "name": "/" }
    ],
    "users": [
    {
        "name": "appuser",
        "password": "your_rabbitmq_password_here",
        "tags": "administrator"
    }
    ],
    "permissions": [
    {
        "user": "appuser",
        "vhost": "/",
        "configure": ".*",
        "write": ".*",
        "read": ".*"
    }
    ],
    "policies": [
    {
        "vhost": "/",
        "name": "stripe-dlx",
        "pattern": "^stripe_",
        "apply-to": "queues",
        "definition": {
            "dead-letter-exchange": "stripe.dlx",
            "dead-letter-routing-key": "stripe.failed"
        },
        "priority": 7
    }
    ]
}